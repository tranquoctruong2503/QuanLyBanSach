<style>
    /* Styles cho nút mở Chatbot */
    .chat-widget-button {
        position: fixed;
        bottom: 20px;
        right: 20px;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        color: white;
        border: none;
        font-size: 28px;
        cursor: pointer;
        box-shadow: 0 4px 20px rgba(13, 110, 253, 0.4);
        z-index: 9999;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .chat-widget-button:hover {
            transform: scale(1.1);
            box-shadow: 0 6px 30px rgba(13, 110, 253, 0.6);
        }

    .chat-badge {
        position: absolute;
        top: -5px;
        right: -5px;
        background: #dc3545;
        color: white;
        font-size: 10px;
        font-weight: bold;
        padding: 2px 6px;
        border-radius: 10px;
        border: 2px solid white;
    }

    /* Styles cho khung Chatbox */
    .chatbox-popup {
        position: fixed;
        bottom: 90px;
        right: 20px;
        width: 380px;
        height: 550px;
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        z-index: 9998;
        display: none; /* Mặc định ẩn, sẽ hiển thị qua JS (display: flex) */
        flex-direction: column;
        overflow: hidden;
    }

    /* Responsive cho điện thoại (Lưu ý: dùng @@ để không bị lỗi Razor trong MVC) */
    @@media (max-width: 576px) {
        .chatbox-popup {
            width: calc(100vw - 40px); /* Tự động co giãn theo chiều ngang */
            height: 500px;
            right: 20px;
        }
    }

    .chatbox-header {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        color: white;
        padding: 15px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .chatbox-header-content {
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .chatbox-header-content i {
            font-size: 24px;
        }

        .chatbox-header-content h4 {
            margin: 0;
            font-size: 16px;
            font-weight: 600;
        }

        .chatbox-header-content p {
            margin: 0;
            font-size: 12px;
            opacity: 0.9;
        }

    .chatbox-close-btn {
        background: rgba(255,255,255,0.2);
        border: none;
        color: white;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        cursor: pointer;
        font-size: 16px;
    }

    .chatbox-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #f8f9fa;
    }

    .chatbox-messages {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
    }

    .chatbox-welcome {
        text-align: center;
        padding: 20px;
        background: white;
        border-radius: 15px;
        margin-bottom: 15px;
    }

        .chatbox-welcome i {
            font-size: 40px;
            color: #0d6efd;
            margin-bottom: 10px;
        }

        .chatbox-welcome h5 {
            margin: 10px 0 5px 0;
            color: #333;
            font-size: 18px;
        }

        .chatbox-welcome p {
            margin: 0;
            color: #6c757d;
            font-size: 14px;
        }

    .chatbox-suggestions {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .suggestion-btn {
        background: white;
        border: 2px solid #e9ecef;
        padding: 12px 15px;
        border-radius: 12px;
        cursor: pointer;
        font-size: 14px;
        text-align: left;
        transition: all 0.2s;
        color: #333;
    }

        .suggestion-btn:hover {
            background: #0d6efd;
            color: white;
            border-color: #0d6efd;
            transform: translateX(5px);
        }

    .chatbox-message {
        display: flex;
        margin-bottom: 15px;
    }

        .chatbox-message.user {
            justify-content: flex-end;
        }

    .chatbox-message-content {
        max-width: 75%;
        padding: 12px 15px;
        border-radius: 15px;
        font-size: 14px;
        line-height: 1.5;
    }

    .chatbox-message.bot .chatbox-message-content {
        background: white;
        color: #333;
        border-bottom-left-radius: 5px;
    }

    .chatbox-message.user .chatbox-message-content {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        color: white;
        border-bottom-right-radius: 5px;
    }

    /* Hiệu ứng 3 dấu chấm đang gõ chữ */
    .chatbox-typing {
        display: flex;
        gap: 4px;
        padding: 12px 15px;
        background: white;
        border-radius: 15px;
        width: fit-content;
    }

        .chatbox-typing span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #0d6efd;
            animation: typing 1.4s infinite;
        }

            .chatbox-typing span:nth-child(2) {
                animation-delay: 0.2s;
            }

            .chatbox-typing span:nth-child(3) {
                animation-delay: 0.4s;
            }

    @@keyframes typing {
        0%, 60%, 100% {
            transform: translateY(0);
            opacity: 0.7;
        }

        30% {
            transform: translateY(-8px);
            opacity: 1;
        }
    }

    .chatbox-input-area {
        padding: 15px;
        background: white;
        border-top: 1px solid #e9ecef;
        display: flex;
        gap: 10px;
    }

    .chatbox-input {
        flex: 1;
        padding: 12px 15px;
        border: 2px solid #e9ecef;
        border-radius: 25px;
        font-size: 14px;
        outline: none;
    }

        .chatbox-input:focus {
            border-color: #0d6efd;
        }

    .chatbox-send-btn {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        color: white;
        border: none;
        cursor: pointer;
        font-size: 16px;
    }

        .chatbox-send-btn:hover {
            transform: scale(1.1);
        }
</style>

<!-- ============================================== -->
<!-- GIAO DIỆN HTML CHATBOT -->
<!-- ============================================== -->
<div id="aiChatWidget">
    <!-- Nút hình con Robot -->
    <button id="chatToggleBtn" class="chat-widget-button" onclick="toggleChatbox()">
        <i class="fas fa-robot"></i>
        <span class="chat-badge">AI</span>
    </button>

    <!-- Khung Chatbox -->
    <div id="chatboxPopup" class="chatbox-popup">
        <!-- Phần Header -->
        <div class="chatbox-header">
            <div class="chatbox-header-content">
                <i class="fas fa-robot"></i>
                <div>
                    <h4>Trợ Lý AI</h4>
                    <p>ALPHA BOOK</p>
                </div>
            </div>
            <button onclick="toggleChatbox()" class="chatbox-close-btn">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <!-- Phần Body (Nơi chứa tin nhắn) -->
        <div class="chatbox-body">
            <div id="chatboxMessages" class="chatbox-messages">
                <!-- Lời chào mặc định -->
                <div class="chatbox-welcome">
                    <i class="fas fa-book-reader"></i>
                    <h5>Xin chào! 👋</h5>
                    <p>Tôi là trợ lý AI của ALPHA BOOK. Tôi có thể giúp gì cho bạn?</p>
                </div>

                <!-- Các nút gợi ý -->
                <div class="chatbox-suggestions">
                    <button class="suggestion-btn" onclick="sendQuickMessage('Gợi ý sách hay')">📚 Gợi ý sách hay</button>
                    <button class="suggestion-btn" onclick="sendQuickMessage('Cách đặt hàng')">🛒 Cách đặt hàng</button>
                    <button class="suggestion-btn" onclick="sendQuickMessage('Chính sách đổi trả')">🔄 Chính sách đổi trả</button>
                </div>
            </div>

            <!-- Khung nhập tin nhắn -->
            <div class="chatbox-input-area">
                <input type="text" id="chatboxInput" class="chatbox-input" placeholder="Nhập câu hỏi của bạn..." onkeypress="handleChatboxKeyPress(event)">
                <button onclick="sendChatMessage()" class="chatbox-send-btn">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================== -->
<!-- JAVASCRIPT XỬ LÝ CHAT -->
<!-- ============================================== -->
<script>
    // Hàm bật/tắt khung chat
    function toggleChatbox() {
        const popup = document.getElementById('chatboxPopup');
        if (popup.style.display === 'none' || popup.style.display === '') {
            popup.style.display = 'flex';
            document.getElementById('chatboxInput').focus();
        } else {
            popup.style.display = 'none';
        }
    }

    // Hàm thêm tin nhắn vào màn hình
    function addChatMessage(content, isUser) {
        const messagesContainer = document.getElementById('chatboxMessages');

        // Ẩn lời chào và nút gợi ý khi bắt đầu chat
        if (isUser) {
            const welcome = messagesContainer.querySelector('.chatbox-welcome');
            const suggestions = messagesContainer.querySelector('.chatbox-suggestions');
            if (welcome) welcome.remove();
            if (suggestions) suggestions.remove();
        }

        const messageDiv = document.createElement('div');
        messageDiv.className = `chatbox-message ${isUser ? 'user' : 'bot'}`;

        const contentDiv = document.createElement('div');
        contentDiv.className = 'chatbox-message-content';

        // Bot trả về Markdown nên cần convert sang HTML
        contentDiv.innerHTML = isUser ? content : convertMarkdownToHtml(content);

        messageDiv.appendChild(contentDiv);
        messagesContainer.appendChild(messageDiv);

        // Tự động cuộn xuống cuối cùng
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    // Đổi Markdown của Google AI thành chữ in đậm, in nghiêng, xuống dòng...
    function convertMarkdownToHtml(markdown) {
        let html = markdown.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
        html = html.replace(/\*(.*?)\*/g, '<em>$1</em>');
        html = html.replace(/\n/g, '<br>');
        return html;
    }

    // Hiển thị 3 dấu chấm đang gõ
    function showTyping() {
        const messagesContainer = document.getElementById('chatboxMessages');
        const typingDiv = document.createElement('div');
        typingDiv.className = 'chatbox-message bot';
        typingDiv.id = 'typingIndicator';
        typingDiv.innerHTML = '<div class="chatbox-typing"><span></span><span></span><span></span></div>';
        messagesContainer.appendChild(typingDiv);
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    // Xóa 3 dấu chấm đang gõ
    function removeTyping() {
        const typing = document.getElementById('typingIndicator');
        if (typing) typing.remove();
    }

    // Hàm gọi lên máy chủ (Backend C#)
    async function sendChatMessage() {
        const input = document.getElementById('chatboxInput');
        const message = input.value.trim();
        if (!message) return;

        input.value = '';
        input.disabled = true; // Khóa ô nhập liệu trong lúc đợi

        // Hiển thị tin nhắn của user và icon đang gõ chữ
        addChatMessage(message, true);
        showTyping();

        try {
            // Gọi về Controller C# của bạn (thay vì gọi thẳng API Google)
            const response = await fetch('/Chat/SendMessage', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ message: message })
            });

            removeTyping(); // Xóa icon đang gõ chữ

            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }

            // Nhận kết quả từ ChatController
            const data = await response.json();

            if (data.success && data.reply) {
                // In câu trả lời ra
                addChatMessage(data.reply, false);
            } else {
                addChatMessage(data.error || 'Xin lỗi, tôi không nhận được phản hồi.', false);
                console.error("Lỗi từ C#:", data.error);
            }

        } catch (error) {
            removeTyping();
            addChatMessage('Đã có lỗi kết nối với máy chủ của chúng tôi. Vui lòng thử lại!', false);
            console.error('Lỗi JS:', error);
        }

        input.disabled = false; // Mở lại ô nhập liệu
        input.focus();
    }

    // Gửi nhanh qua nút gợi ý
    function sendQuickMessage(text) {
        document.getElementById('chatboxInput').value = text;
        sendChatMessage();
    }

    // Gửi khi nhấn phím Enter
    function handleChatboxKeyPress(event) {
        if (event.key === 'Enter') {
            event.preventDefault();
            sendChatMessage();
        }
    }
</script>