<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trang Chủ - ALPHA BOOK</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <style>
        /* Thiết lập font và màu nền */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f0f2f5;
            color: #1a202c;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden; /* Ngăn cuộn ngang */
            /* ĐÃ XÓA: width: 1500px */
        }

        /* Custom styles cho thanh tìm kiếm */
        .search-container input {
            padding-right: 2.5rem;
            border-radius: 0.5rem;
            border: 2px solid #ced4da;
        }

        .search-container input:focus {
            border-color: #0d6efd;
            box-shadow: none;
        }

        .product-card {
            border-radius: 1rem;
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        }

        /* Sticky Header */
        header {
            top: 0;
            z-index: 1030;
            position: sticky;
        }
      

        /* Màu chữ mặc định của menu (cho hơi mờ một chút để phân biệt với trang đang chọn) */
        .navbar-nav .nav-link {
            transition: all 0.3s ease-in-out;
            color: rgba(255, 255, 255, 0.75) !important; /* Trắng đục */
            border-bottom: 2px solid transparent; /* Chuẩn bị sẵn viền dưới để không bị giật layout */
        }

            /* 1. Hiệu ứng Hover: Khi rê chuột vào -> Chữ sáng thành màu trắng tinh */
            .navbar-nav .nav-link:hover {
                color: #ffffff !important;
            }

            /* 2. Hiệu ứng Active: Khi đang ở đúng trang đó -> Chữ màu trắng tinh, in đậm và có gạch chân */
            .navbar-nav .nav-link.active {
                color: #ffffff !important;
                font-weight: 700; /* Tô đậm chữ */
            }
       

        
    </style>
</head>
<body>

    <header class="bg-white shadow-sm">
        <div class="container py-3">
            <!-- ĐÃ SỬA: Dùng class col-lg thay cho col-md để chia tỷ lệ chuẩn hơn trên màn hình máy tính -->
            <div class="row align-items-center">

                <!-- 1. LOGO (Chiếm 3/12 phần trên Desktop) -->
                <div class="col-6 col-lg-3 d-flex align-items-center">
                    <div class="fs-3 fw-bolder text-primary d-flex align-items-center gap-2">
                        <img src="~/Images/logo.png" width="50" height="50" alt="Logo" />
                        <span class="">ALPHA BOOK</span>
                    </div>
                </div>

                <!-- 2. TÀI KHOẢN & GIỎ HÀNG (Chiếm 4/12 phần trên Desktop để có dư không gian cho tên dài) -->
                <div class="col-6 col-lg-4 d-flex justify-content-end align-items-center gap-3 order-2 order-lg-3">
                    <div class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-primary fw-bold d-flex align-items-center" href="#" id="navbarDropdown"
                           role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-user me-1"></i>
                            @if (Session["userID"] != null)
                        {
                            <!-- ĐÃ SỬA: Thêm class text-truncate và max-width để tự động có dấu ... nếu tên quá dài -->
                            <span class="d-none d-md-inline-block text-truncate align-middle" style="max-width: 160px;" title='Xin chào, @Session["HoTen"]'>
                                Xin chào, @Session["HoTen"]
                            </span>
                        }
                        else
                        {
                            <span class="d-none d-md-inline">Tài khoản</span>
                        }
                        </a>

                        <!-- Menu Dropdown -->
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                            @if (Session["userID"] == null)
                        {
                            <li><a class="dropdown-item" href="@Url.Action("DangNhap", "TaiKhoan")"><i class="fas fa-sign-in-alt me-1"></i>Đăng nhập</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("DangKy", "TaiKhoan")"><i class="fas fa-user-plus me-1"></i>Đăng ký</a></li>
                        }
                        else
                        {
                            if (Session["Role"] != null && Session["Role"].ToString() == "admin")
                            {
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Admin")"><i class="fas fa-tools me-1"></i>Trang quản trị</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            }
                            <li><a class="dropdown-item" href="@Url.Action("ThongTinCaNhan", "TaiKhoan")"><i class="fas fa-id-card me-1"></i>Thông tin cá nhân</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("ThanhVien", "Home")"><i class="fas fa-crown me-1"></i> Thành Viên</a></li>
                            <li><a class="dropdown-item text-danger" href="@Url.Action("DangXuat", "TaiKhoan")"><i class="fas fa-sign-out-alt me-1"></i>Đăng xuất</a></li>
                        }
                        </ul>
                    </div>

                    @Html.Action("GioHangPartial", "Home")
                </div>

                <!-- 3. THANH TÌM KIẾM (Chiếm 5/12 phần trên Desktop) -->
                <!-- ĐÃ SỬA: Bỏ max-width cố định để ô tìm kiếm tự động co giãn vừa khít không gian còn lại -->
                <div class="col-12 col-lg-5 order-3 order-lg-2 mt-3 mt-lg-0">
                    <form action="@Url.Action("SearchSanPham", "Home")" method="get" class="input-group search-container w-100">
                        <input type="text" name="keyword" class="form-control"
                               placeholder="Tìm theo tên sách, tác giả, thể loại..."
                               value="@Request["keyword"]" />
                        <button class="btn btn-primary" type="submit" id="button-addon2">
                            <i class="fas fa-search"></i>
                        </button>
                    </form>
                </div>

            </div>
        </div>

        <!-- THANH MENU NAV -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container">
                <button class="navbar-toggler d-flex d-lg-none align-items-center gap-2" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu" aria-controls="mainMenu" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                    <span class="text-white fw-medium" style="font-size: 16px;">Mục Lục</span>
                </button>

                <div class="collapse navbar-collapse" id="mainMenu">
                    @{
                    string currentAction = ViewContext.RouteData.Values["Action"] != null ? ViewContext.RouteData.Values["Action"].ToString() : "";
                    }

                    <ul class="navbar-nav w-100 mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "Trangchu" ? "active" : "")" href="~/Home/Trangchu">
                                <i class="fas fa-home me-1"></i> Trang Chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "SanPham" ? "active" : "")" href="~/Home/SanPham">
                                <i class="fas fa-box me-1"></i> Sản Phẩm
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "GioiThieu" ? "active" : "")" href="~/Home/GioiThieu">
                                <i class="fas fa-info-circle me-1"></i> Giới Thiệu
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "TinTuc" ? "active" : "")" href="~/Home/TinTuc">
                                <i class="fas fa-newspaper me-1"></i> Tin Tức
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "LienHe" ? "active" : "")" href="~/Home/LienHe">
                                <i class="fas fa-envelope me-1"></i> Liên Hệ
                            </a>
                        </li>
                        <li class="nav-item ms-lg-auto">
                            <a class="nav-link @(currentAction == "LichSuDonHang" ? "active" : "")" href="~/Home/LichSuDonHang">
                                <i class="fas fa-history me-1"></i> Lịch sử Đơn Hàng
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="bg-white text-dark mt-5 py-5 border-top">
        <div class="container">
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
                <div class="col">
                    <h2 class="d-flex align-items-center mb-3">
                        <div class="fs-4 fw-bolder text-primary d-flex align-items-center gap-2">
                            <img src="~/Images/logo.png" width="40" height="40" alt="Logo" />
                            ALPHA BOOK
                        </div>
                    </h2>
                    <p class="text-secondary small d-flex align-items-center mb-2"><i class="fas fa-map-marker-alt me-2 text-primary"></i> Đường 3/2, Quận 10, TP.HCM</p>
                    <p class="text-secondary small d-flex align-items-center mb-2"><i class="fas fa-envelope me-2 text-primary"></i> contact@alphabook.vn</p>
                    <p class="text-secondary small d-flex align-items-center"><i class="fas fa-phone me-2 text-primary"></i> (028) 123 4567</p>
                </div>

                <div class="col">
                    <h3 class="fs-6 fw-semibold mb-3 text-primary">VỀ ALPHA BOOK</h3>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="#" class="text-secondary text-decoration-none hover-text-primary">Trang Chủ</a></li>
                        <li class="mb-2"><a href="#" class="text-secondary text-decoration-none hover-text-primary">Sản Phẩm</a></li>
                        <li class="mb-2"><a href="#" class="text-secondary text-decoration-none hover-text-primary">Tin Tức</a></li>
                        <li class="mb-2"><a href="#" class="text-secondary text-decoration-none hover-text-primary">Giới Thiệu</a></li>
                    </ul>
                </div>

                <div class="col">
                    <h3 class="fs-6 fw-semibold mb-3 text-primary">HỖ TRỢ KHÁCH HÀNG</h3>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="#" class="text-secondary text-decoration-none hover-text-primary">Chính sách đổi trả</a></li>
                        <li class="mb-2"><a href="#" class="text-secondary text-decoration-none hover-text-primary">Chính sách bảo mật</a></li>
                        <li class="mb-2"><a href="#" class="text-secondary text-decoration-none hover-text-primary">Phương thức thanh toán</a></li>
                        <li class="mb-2"><a href="#" class="text-secondary text-decoration-none hover-text-primary">Câu hỏi thường gặp</a></li>
                    </ul>
                </div>

                <div class="col">
                    <h3 class="fs-6 fw-bold mb-3 text-primary">FANPAGE</h3>
                    <div class="d-flex flex-column gap-2">
                        <a href="#" class="text-secondary text-decoration-none"><i class="fab fa-facebook-f fa-lg text-primary me-2"></i> Facebook</a>
                        <a href="#" class="text-secondary text-decoration-none"><i class="fab fa-instagram fa-lg text-primary me-2"></i> Instagram</a>
                        <a href="#" class="text-secondary text-decoration-none"><i class="fab fa-twitter fa-lg text-primary me-2"></i> Twitter</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-5 pt-3 border-top border-secondary-subtle text-center">
            <p class="text-secondary small mb-0">© 2026 ALPHA BOOK. Bản quyền thuộc về ALPHA BOOK.</p>
        </div>
    </footer>

    @Html.Partial("_Chatbot")

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>

</body>
</html>