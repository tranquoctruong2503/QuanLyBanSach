@model List<Nhom06_QuanLyBanSah.Models.GioHang>
@{
    ViewBag.Title = "Đặt Hàng";
    Layout = "~/Views/Shared/_LayoutPage1.cshtml";
    decimal soTienGiam = Session["SoTienGiam"] != null ? (decimal)Session["SoTienGiam"] : 0;
}

<div class="container py-5">
    <h2 class="mb-4 text-primary fw-bold text-center text-md-start">
        <i class="fas fa-file-invoice-dollar me-2"></i>Tiến Hành Đặt Hàng
    </h2>

    @if (TempData["Error"] != null)
    {
    <div class="alert alert-danger alert-dismissible fade show shadow-sm">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    }

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card custom-card-shadow border-0 rounded-4 ">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-2">
                    <h5 class="fw-bold text-dark mb-0"><i class="fas fa-map-marked-alt text-primary me-2"></i>Thông tin giao hàng</h5>
                </div>

                <div class="card-body p-4">
                    @using (Html.BeginForm("DatHang", "Home", FormMethod.Post))
                    {
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Số điện thoại liên hệ:</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fas fa-phone text-muted"></i></span>
                            <input type="text" name="soDienThoai" class="form-control border-start-0" value="@ViewBag.DienThoaiMacDinh" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Địa chỉ giao hàng:</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fas fa-home text-muted"></i></span>
                            <input type="text" name="diaChiGiaoHang" class="form-control border-start-0" value="@ViewBag.DiaChiMacDinh" required />
                        </div>
                    </div>

                    

                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold rounded-3 shadow-sm custom-btn-hover">
                        <i class="fas fa-check me-2"></i> XÁC NHẬN ĐỊA CHỈ
                    </button>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card custom-card-shadow border-0 rounded-4 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-2">
                    <h5 class="fw-bold text-dark mb-0"><i class="fas fa-box-open text-primary me-2"></i>Tóm tắt đơn hàng</h5>
                </div>

                <div class="card-body p-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-4">
                            <thead class="table-light">
                                <tr>
                                    <th class="border-0" style="width: 25%">Ảnh</th>


                                    <th class="border-0" style="width: 40%;">Tên Sách</th>
                                    <th class="border-0 text-center" style="width: 15%;">SL</th>
                                    <th class="border-0 text-end" style="width: 20%;">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ decimal tongTien = 0; }
                                @foreach (var item in Model)
                                {
                                    decimal thanhTien = (decimal)item.dDonGia * item.iSoLuong;
                                    tongTien += thanhTien;
                                <tr>
                                    <td>
                                        <img src="~/HinhSP/@item.sAnhBia"
                                             alt="@item.sTenSach"
                                             class="img-thumbnail"
                                             style="width: 60px; height: 80px; object-fit: cover;" />
                                    </td>
                                    <td><span class="text-primary fw-semibold">@item.sTenSach</span></td>
                                    <td class="text-center">@item.iSoLuong</td>
                                    <td class="text-end fw-bold text-dark">@string.Format("{0:N0} ₫", thanhTien)</td>
                                </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                 

                    <div class="bg-light p-4 rounded-3 border mt-3 shadow-sm">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted fw-semibold">Tạm tính:</span>
                            <span class="fw-bold text-dark">@string.Format("{0:N0} ₫", tongTien)</span>
                        </div>

                        @if (soTienGiam > 0)
{
                        <div class="d-flex justify-content-between align-items-center mb-2 text-success">
                            <span class="fw-semibold"><i class="fas fa-tag me-2"></i>Mã giảm giá:</span>
                            <span class="fw-bold">-@string.Format("{0:N0} ₫", soTienGiam)</span>
                        </div>
}

                        <hr class="my-3 opacity-10">

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fs-5 fw-bold text-dark">Tổng cần thanh toán:</span>
                            <div class="text-end">
                                <span class="fs-3 fw-bold text-danger">@string.Format("{0:N0} ₫", tongTien - soTienGiam)</span>

                            </div>
                        </div>

                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .custom-card-shadow {
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .custom-card-shadow:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
        }

    .input-group-text {
        border-color: #ced4da;
    }

    .form-control:focus {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }

    .custom-btn-hover {
        transition: all 0.3s ease;
    }

        .custom-btn-hover:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(13, 110, 253, 0.4) !important;
        }
</style>