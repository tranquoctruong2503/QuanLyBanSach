@model Nhom06_QuanLyBanSah.Models.TAIKHOAN

@{
    ViewBag.Title = "Thông tin cá nhân";
    Layout = "~/Views/Shared/_LayoutPage1.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card custom-card-shadow border-0 rounded-4">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 text-center">
                    <h2 class="fw-bold text-primary text-uppercase mb-0">
                        Thông Tin Cá Nhân
                    </h2>
                </div>

                <div class="card-body p-4 p-md-5">

                    @if (ViewBag.Success != null)
                    {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i>@ViewBag.Success
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                    }
                    @if (ViewBag.Error != null)
                    {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>@ViewBag.Error
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                    }

                    @using (Html.BeginForm("ThongTinCaNhan", "TaiKhoan", FormMethod.Post, new { @class = "needs-validation" }))
                    {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.userID)
                    @Html.HiddenFor(m => m.Email)
                    @Html.HiddenFor(m => m.MatKhau)
                    @Html.HiddenFor(m => m.Role)

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-user text-muted"></i></span>
                                @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control border-start-0", required = "required" })
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email <span class="text-muted" style="font-size: 0.85em;">(Không thể thay đổi)</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-envelope text-muted"></i></span>
                                <input type="text" class="form-control border-start-0 bg-light text-muted" value="@Model.Email" disabled />
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-phone text-muted"></i></span>
                                @Html.TextBoxFor(m => m.DienThoai, new { @class = "form-control border-start-0", required = "required" })
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Ngày sinh <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-calendar-alt text-muted"></i></span>
                                @Html.TextBoxFor(m => m.NgaySinh, "{0:yyyy-MM-dd}", new { @class = "form-control border-start-0", type = "date", required = "required" })
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Giới tính <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-venus-mars text-muted"></i></span>
                                @Html.DropDownListFor(m => m.GioiTinh,
                                    new SelectList(new[] { "Nam", "Nữ", "Khác" }, Model.GioiTinh),
                                    new { @class = "form-select border-start-0" })
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Địa chỉ <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-map-marker-alt text-muted"></i></span>
                                @Html.TextBoxFor(m => m.DiaChi, new { @class = "form-control border-start-0", placeholder = "Nhập địa chỉ đầy đủ...", required = "required" })
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4 pt-2">
                        <div class="col-md-6 mb-2 mb-md-0 d-grid">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold rounded-3 shadow-sm custom-btn-hover">
                                <i class="fas fa-save me-2"></i> LƯU THAY ĐỔI
                            </button>
                        </div>
                        <div class="col-md-6 d-grid">
                            <a href="@Url.Action("DoiMatKhau", "TaiKhoan")" class="btn btn-outline-secondary btn-lg fw-bold rounded-3 shadow-sm custom-btn-hover">
                                <i class="fas fa-key me-2"></i> ĐỔI MẬT KHẨU
                            </a>
                        </div>
                    </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* CSS chuẩn đồng bộ 100% với toàn bộ Module Tài Khoản */
    .custom-card-shadow {
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .custom-card-shadow:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
        }

    .input-group-text {
        border-color: #ced4da;
    }

    .form-control:focus, .form-select:focus {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }

    /* Đảm bảo ô input disabled trông vẫn tự nhiên */
    .form-control:disabled, .form-control[readonly] {
        background-color: #f8f9fa;
        opacity: 1;
    }

    .custom-btn-hover {
        transition: all 0.3s ease;
    }

        .custom-btn-hover:hover {
            transform: translateY(-2px);
        }

    .btn-primary.custom-btn-hover:hover {
        box-shadow: 0 5px 15px rgba(13, 110, 253, 0.4) !important;
    }

    .btn-outline-secondary.custom-btn-hover:hover {
        box-shadow: 0 5px 15px rgba(108, 117, 125, 0.2) !important;
    }
</style>